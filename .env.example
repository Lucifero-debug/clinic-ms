# Copy to .env and fill in. .env is gitignored.
#
# IMPORTANT: use .env, NOT .env.local.
# The Prisma CLI (migrate, db push, studio) only reads .env. Next.js reads
# both, so .env works for everything. Using .env.local means Prisma cannot
# see DATABASE_URL and every CLI command fails.

# --- required ---------------------------------------------------

# Postgres. Neon (neon.tech) or Supabase (supabase.com), both free to start.
# Prisma needs a DIRECT connection string for migrations, not a pooled one.
# On Neon that is the URL without "-pooler" in the host.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the session cookie. At least 32 random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this signs everyone out.
SESSION_SECRET="c640a05810a146ace994b9078471a01414d8fc3dd06794b3178848b3b1b8e4fd"

# --- optional: WhatsApp appointment reminders -------------------
# Without these the reminders screen still lists who is due, but the
# send button is hidden. The template must be approved in Meta Business
# Manager first, with three body placeholders in this order:
#   {{1}} patient name  {{2}} clinic name  {{3}} appointment time
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=appointment_reminder
# WHATSAPP_TEMPLATE_LANG=en
